# Copia este archivo como .env y cambia AMBOS valores.
# El dominio debe apuntar por DNS al servidor que aloja SHINKA Engine.
SHINKA_ENGINE_DOMAIN=ai-engine.example.com

# Usa una clave aleatoria larga y privada. Debe coincidir con el secreto
# SHINKA_AI_API_KEY configurado en Supabase Edge Functions.
SHINKA_AI_API_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_LARGO
